# Public project URL; safe to expose in frontend applications.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Use only a Supabase publishable/anon key in frontend code.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Never commit real server-side secrets.
SUPABASE_SERVICE_ROLE_KEY=replace_in_local_environment_only
OPENAI_API_KEY=replace_in_local_environment_only
N8N_ENCRYPTION_KEY=replace_in_local_environment_only
