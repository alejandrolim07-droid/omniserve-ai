      "parameters": {
        "jsCode": "const input = $json.body ?? $json;\nconst message = String(input.message ?? input.description ?? '').trim();\nif (!message) throw new Error('message is required');\nreturn [{json:{message,context:input.context ?? {},prompt:`Customer message: ${message}\\nContext: ${JSON.stringify(input.context ?? {})}`}}];"
      },
