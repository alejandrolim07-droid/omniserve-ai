        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ model: 'gpt-4.1-mini', temperature: 0, response_format: { type: 'json_object' }, messages: [{ role: 'system', content: 'Analyze the customer message sentiment. Return only JSON with keys sentiment, score, emotions, churn_risk, requires_human_review, rationale. sentiment must be POSITIVE, NEUTRAL, or NEGATIVE. score must be between -1 and 1.' }, { role: 'user', content: $json.prompt }] }) }}",
        "options": {}
      },
