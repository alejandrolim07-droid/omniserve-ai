    },
    {
      "parameters": {
        "jsCode": "const raw = $json.choices?.[0]?.message?.content;\nif (!raw) throw new Error('OpenAI returned no classification');\nlet result;\ntry { result = JSON.parse(raw); } catch { throw new Error('OpenAI response was not valid JSON'); }\nreturn [{json:{success:true,...result}}];"
      },
